BOT_TOKEN=PASTE_TELEGRAM_BOT_TOKEN_HERE
SOURCE_CHAT_ID=-1003970343773
ROUTES_FILE=routes.json
MODE=copy

# Optional fallback chat for messages without a matched route.
# UNKNOWN_CHAT_ID=

HEALTH_ENABLED=1
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8095
LOG_HEARTBEAT_INTERVAL=300
BOOTSTRAP_RETRIES=-1
DROP_PENDING_UPDATES=0
IGNORE_BOT_MESSAGES=1
ALLOWED_UPDATES=message,channel_post

WEBHOOK_ENABLED=1
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8096
WEBHOOK_PATH=/lamaree-tilda/CHANGE_ME_TO_SECRET_PATH
WEBHOOK_SEND_TO_SOURCE=1
WEBHOOK_MAX_BODY_BYTES=262144
DB_FILE=/var/lib/lamaree-telegram-router/router.sqlite3
