[Unit]
Description=La Maree Telegram Router Bot
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=lamaree-router
Group=lamaree-router
WorkingDirectory=/opt/lamaree-telegram-router
EnvironmentFile=/etc/lamaree-telegram-router/lamaree.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/lamaree-telegram-router/.venv/bin/python /opt/lamaree-telegram-router/bot.py
Restart=always
RestartSec=10
KillSignal=SIGINT
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/tmp /var/lib/lamaree-telegram-router
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
